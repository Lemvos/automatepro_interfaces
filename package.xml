<package format="3">
  <name>automatepro_interfaces</name>
  <version>1.1.0</version>
  <description>ROS 2 message, service and action definitions for the AutomatePro IO controller and drivers.</description>
  <maintainer email="engineering@lemvos.com">Lemvos Robotics GmbH</maintainer>
  <license file="LICENSE">Apache-2.0</license>
  <author email="engineering@lemvos.com">Lemvos Robotics GmbH</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <!-- Action definitions carry goal IDs and status from action_msgs. -->
  <depend>action_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
